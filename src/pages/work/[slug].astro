---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Illustration from '../../components/Illustration.astro';

export async function getStaticPaths() {
  const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: work[(i + 1) % work.length] },
  }));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Base title={`${d.title} | John Well Arellano`} description={d.summary}>
  <article>
    <header class="head">
      <div class="glow" aria-hidden="true"></div>
      <div class="container inner">
        <a class="back" href="/#work">&larr; All work</a>
        <span class="area">{d.area}</span>
        <h1>{d.title}</h1>
        <p class="summary">{d.summary}</p>
        <p class="meta">{d.org} · {d.period}</p>
      </div>
    </header>

    <div class="container">
      <div class="frame">
        <div class="art"><Illustration slug={entry.id} /></div>
      </div>

      <ul class="outcomes">
        {
          d.outcomes.map((o) => (
            <li>
              <strong>{o.value}</strong>
              <span>{o.label}</span>
            </li>
          ))
        }
      </ul>

      <section class="flow-wrap" aria-label="Solution flow">
        <h2>Solution flow</h2>
        <ol class="flow">
          {d.flow.map((f) => <li>{f}</li>)}
        </ol>
      </section>

      <div class="body">
        <div class="prose">
          <Content />
        </div>
        <aside class="tools">
          <h2>Tools used</h2>
          <ul class="chips">
            {d.tools.map((t) => <li class="chip">{t}</li>)}
          </ul>
        </aside>
      </div>

      <nav class="next" aria-label="Next case study">
        <a href={`/work/${next.id}/`}>
          <span>Next case study</span>
          <strong>{next.data.title} &rarr;</strong>
        </a>
      </nav>
    </div>
  </article>
</Base>

<style>
  .head {
    position: relative;
    overflow: hidden;
    margin-top: -72px;
    padding: 130px 0 40px;
  }
  .glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(560px 300px at 10% 15%, rgba(196, 181, 253, 0.4), transparent 70%),
      radial-gradient(640px 340px at 90% 5%, rgba(253, 186, 160, 0.5), transparent 70%);
    mask-image: linear-gradient(180deg, #000 55%, transparent 100%);
    pointer-events: none;
  }
  .inner {
    position: relative;
  }
  .back {
    display: inline-block;
    color: var(--muted);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
    margin-bottom: 22px;
  }
  .back:hover {
    color: var(--accent);
  }
  .area {
    display: block;
    font-weight: 800;
    font-size: 0.9rem;
    color: var(--accent);
    margin-bottom: 6px;
  }
  h1 {
    font-size: clamp(2rem, 4.8vw, 3.2rem);
    max-width: 880px;
  }
  .summary {
    font-size: 1.12rem;
    color: #3a3533;
    max-width: 760px;
  }
  .meta {
    color: var(--muted);
    font-size: 0.92rem;
    margin: 0;
  }
  .frame {
    padding: 14px;
    border-radius: var(--radius);
    background: var(--frame);
    max-width: 760px;
    margin: 0 auto;
  }
  .art {
    border-radius: 18px;
    overflow: hidden;
    aspect-ratio: 400 / 260;
  }
  .art :global(svg) {
    width: 100%;
    height: 100%;
  }
  .outcomes {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  @media (min-width: 720px) {
    .outcomes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .outcomes li {
    padding: 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-radius: 22px;
    background: var(--coral);
    color: #ffffff;
    box-shadow: 0 8px 24px rgba(120, 20, 40, 0.14);
  }
  .outcomes strong {
    font-family: var(--font-head);
    font-size: 1.9rem;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .outcomes span {
    font-size: 0.92rem;
    line-height: 1.45;
  }
  .flow-wrap {
    margin: 44px 0 8px;
  }
  .flow-wrap h2,
  .tools h2 {
    font-size: 1.3rem;
  }
  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }
  .flow li {
    padding: 10px 16px;
    border-radius: 8px;
    background: var(--frame);
    font-size: 0.92rem;
    font-weight: 700;
  }
  .flow li:not(:last-child)::after {
    content: '\2192' / '';
    margin-left: 14px;
    color: var(--accent);
  }
  .body {
    display: grid;
    gap: 32px;
    margin: 40px 0 56px;
  }
  @media (min-width: 960px) {
    .body {
      grid-template-columns: minmax(0, 1fr) 300px;
      align-items: start;
    }
    .tools {
      position: sticky;
      top: 96px;
    }
  }
  .prose {
    max-width: 720px;
    font-size: 1.05rem;
  }
  .prose :global(h2) {
    font-size: 1.45rem;
    margin-top: 1.8em;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(ul) {
    padding-left: 1.2em;
  }
  .prose :global(li) {
    margin-bottom: 0.45em;
  }
  .tools {
    padding: 22px;
    border-radius: var(--radius);
    background: var(--frame);
  }
  .tools .chip {
    white-space: normal;
  }
  .next {
    margin-bottom: 72px;
  }
  .next a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 24px 28px;
    border-radius: var(--radius);
    background: var(--text);
    text-decoration: none;
    color: #ffffff;
  }
  .next a:hover {
    background: #2f2a29;
    color: #ffffff;
  }
  .next span {
    font-size: 0.88rem;
    color: #d9d2cf;
  }
  .next strong {
    font-family: var(--font-head);
    font-size: 1.3rem;
  }
</style>
