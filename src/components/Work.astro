---
import { getCollection } from 'astro:content';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<section id="work" class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Selected work</span>
      <h2>Selected work</h2>
    </div>
    <div class="grid">
      {
        work.map((w) => (
          <article class="card item">
            <span class="tag">{w.data.area}</span>
            <h3>
              <a href={`/work/${w.id}/`}>{w.data.title}</a>
            </h3>
            <p class="summary">{w.data.summary}</p>
            {w.data.outcomes[0] && (
              <p class="result">
                {w.data.outcomes[0].value} {w.data.outcomes[0].label}
              </p>
            )}
            <div class="foot">
              <ul class="chips">
                {w.data.tools.slice(0, 3).map((t) => (
                  <li class="chip">{t}</li>
                ))}
              </ul>
              <span class="more" aria-hidden="true">
                Read case study &rarr;
              </span>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 14px;
  }
  @media (min-width: 760px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .item {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 16px 18px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .item:focus-within {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }
  .item:hover {
    border-color: #bfd3fb;
    box-shadow: 0 6px 20px rgba(37, 99, 235, 0.08);
  }
  .tag {
    align-self: flex-start;
    padding: 2px 9px;
    border-radius: 6px;
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-size: 0.72rem;
    font-weight: 600;
    margin-bottom: 8px;
  }
  h3 {
    font-size: 0.98rem;
    margin-bottom: 4px;
  }
  h3 a {
    color: var(--text);
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }
  .summary {
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.45;
    margin-bottom: 6px;
  }
  .result {
    color: var(--accent);
    font-weight: 700;
    font-size: 0.9rem;
    margin-bottom: 12px;
  }
  .foot {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .more {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.82rem;
    white-space: nowrap;
  }
</style>
