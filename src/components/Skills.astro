---
import { skills } from '../data/site.js';
---

<section id="skills" class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Tools and skills</span>
      <h2>Tools and skills</h2>
    </div>
    <div class="grid">
      {
        skills.map((g) => (
          <div class="card group">
            <h3>{g.group}</h3>
            <ul class="chips">
              {g.items.map((i) => (
                <li class="chip">{i}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
  }
  .group {
    padding: 14px 16px 16px;
    border-radius: 12px;
  }
  h3 {
    font-size: 0.86rem;
    margin-bottom: 10px;
  }
  .chip {
    white-space: normal;
    font-size: 0.76rem;
  }
</style>
