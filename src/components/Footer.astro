---
import { profile } from '../data/site.js';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container row">
    <p>&copy; {year} {profile.name}</p>
    <ul class="links">
      <li><a href="/#get-in-touch">Contact</a></li>
      <li><a href={profile.linkedin} rel="noopener">LinkedIn</a></li>
      <li><a href={profile.github} rel="noopener">GitHub</a></li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 26px 0;
    font-size: 0.92rem;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  p {
    margin: 0;
    color: var(--muted);
  }
  .links {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }
  a:hover {
    color: var(--accent);
  }
</style>
