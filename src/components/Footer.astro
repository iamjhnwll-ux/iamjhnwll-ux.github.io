---
import { profile } from '../data/site.js';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container row">
    <div>
      <strong>{profile.name}</strong>
      <span class="copy">&copy; {year}</span>
    </div>
    <ul class="links">
      <li><a href={`mailto:${profile.email}`}>Email</a></li>
      <li><a href={profile.linkedin} rel="noopener">LinkedIn</a></li>
      <li><a href={profile.github} rel="noopener">GitHub</a></li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    background: var(--surface);
    border-top: 1px solid var(--border);
    padding: 24px 0;
    font-size: 0.9rem;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .copy {
    margin-left: 10px;
    color: var(--muted);
  }
  .links {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    color: var(--muted);
    text-decoration: none;
  }
  a:hover {
    color: var(--accent);
  }
</style>
