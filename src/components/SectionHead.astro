---
const { title, id, linkHref, linkLabel, light = false, intro } = Astro.props;
---

<div class={`head ${light ? 'light' : ''}`}>
  <div class="text">
    <h2 id={id}>{title}</h2>
    <span class="bar" aria-hidden="true"></span>
    {intro && <p class="intro">{intro}</p>}
  </div>
  {linkHref && <a class="all" href={linkHref}>{linkLabel}</a>}
</div>

<style>
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
  }
  .text {
    max-width: 720px;
  }
  h2 {
    margin: 0 0 10px;
  }
  .bar {
    display: block;
    width: 44px;
    height: 4px;
    border-radius: 2px;
    background: var(--coral);
  }
  .intro {
    margin: 14px 0 0;
    color: var(--muted);
    font-size: 1.02rem;
  }
  .all {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .light h2,
  .light .intro,
  .light .all {
    color: #ffffff;
  }
  .light .bar {
    background: #ffffff;
  }
</style>
