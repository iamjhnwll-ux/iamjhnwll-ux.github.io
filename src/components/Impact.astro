---
import { impact } from '../data/site.js';
import SectionHead from './SectionHead.astro';
---

<section class="impact" aria-labelledby="results-title">
  <div class="container">
    <SectionHead title="Results at a glance" id="results-title" light />
    <ul class="grid">
      {
        impact.map((i) => (
          <li>
            <strong>{i.value}</strong>
            <span>{i.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .impact {
    background: var(--coral);
    padding: 52px 0 56px;
    margin: 28px 0;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
  li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px 20px 18px;
    border-radius: 20px;
    background: #ffffff;
    box-shadow: 0 8px 24px rgba(120, 20, 40, 0.18);
  }
  strong {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--text);
  }
  span {
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.4;
  }
</style>
