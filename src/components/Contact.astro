---
import { profile } from '../data/site.js';
---

<section id="contact" class="contact">
  <div class="container">
    <div class="band">
      <div>
        <h2>Have a data problem in mind?</h2>
        <p>
          Open to part-time, contract and direct-hire work with small and medium businesses. Send a
          short note about your sources and goals.
        </p>
      </div>
      <div class="buttons">
        <a class="btn btn--primary" href={`mailto:${profile.email}`}>{profile.email}</a>
        <a class="btn btn--ghost" href={profile.linkedin} rel="noopener">Message on LinkedIn</a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 24px 0 64px;
  }
  .band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 24px 28px;
    border-radius: var(--radius);
    background: #e8f0ff;
    border: 1px solid #d6e3ff;
  }
  h2 {
    font-size: clamp(1.3rem, 2.4vw, 1.6rem);
    margin-bottom: 4px;
  }
  p {
    color: #374151;
    font-size: 0.9rem;
    margin: 0;
    max-width: 520px;
  }
  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .buttons .btn {
    overflow-wrap: anywhere;
  }
</style>
