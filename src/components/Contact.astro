---
import { offers, profile } from '../data/site.js';
---

<section id="contact" class="section contact">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Work with me</span>
      <h2>How I can help your business</h2>
      <p>
        I am open to part-time, contract and direct-hire roles, including remote work with
        Australian and global teams. Small and medium businesses get the same governed approach I
        use on multi-source Microsoft Fabric programmes, sized to your needs.
      </p>
    </div>
    <div class="grid">
      {
        offers.map((o) => (
          <div class="offer">
            <h3>{o.title}</h3>
            <p>{o.text}</p>
          </div>
        ))
      }
    </div>
    <div class="cta card">
      <div>
        <h3>Have a data problem in mind?</h3>
        <p>Send a short note about your sources and goals, and I will get back to you.</p>
      </div>
      <div class="buttons">
        <a class="btn btn--primary" href={`mailto:${profile.email}`}>{profile.email}</a>
        <a class="btn btn--ghost" href={profile.linkedin} rel="noopener">Message on LinkedIn</a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--surface);
    border-top: 1px solid var(--border);
  }
  .grid {
    display: grid;
    gap: 20px;
    margin-bottom: 36px;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1040px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .offer {
    padding: 22px;
    border-radius: 12px;
    background: var(--bg);
    border: 1px solid var(--border);
  }
  .offer p {
    color: var(--muted);
    font-size: 0.93rem;
    margin: 0;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 28px;
    background: linear-gradient(135deg, var(--accent-soft), var(--surface));
  }
  .cta p {
    color: var(--muted);
    margin: 0;
  }
  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .buttons .btn {
    overflow-wrap: anywhere;
  }
</style>
