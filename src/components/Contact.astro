---
import { profile } from '../data/site.js';
---

<section id="contact" class="contact">
  <div class="container">
    <div class="band">
      <div class="glow" aria-hidden="true"></div>
      <h2>Have a data problem in <em class="grad">mind?</em></h2>
      <p>
        I am open to part-time, contract and direct-hire work with small and medium businesses.
        Send a short note about your sources and goals.
      </p>
      <div class="buttons">
        <a class="btn btn--primary" href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">&nearr;</span></a>
        <a class="btn btn--ghost" href={profile.linkedin} rel="noopener">Message on LinkedIn <span aria-hidden="true">&rsaquo;</span></a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 24px 0 72px;
  }
  .band {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding: 56px 24px;
    border-radius: 36px;
    background: var(--frame);
  }
  .glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(420px 240px at 12% 10%, rgba(196, 181, 253, 0.45), transparent 70%),
      radial-gradient(480px 260px at 90% 90%, rgba(253, 186, 160, 0.55), transparent 70%);
    pointer-events: none;
  }
  h2,
  p,
  .buttons {
    position: relative;
  }
  h2 {
    font-size: clamp(1.9rem, 4.4vw, 2.9rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    max-width: 700px;
    margin: 0 auto 14px;
  }
  p {
    color: #3a3533;
    max-width: 540px;
    margin: 0 auto 26px;
  }
  .buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .buttons .btn {
    overflow-wrap: anywhere;
  }
</style>
