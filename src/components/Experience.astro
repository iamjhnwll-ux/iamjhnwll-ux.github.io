---
import { experience, certifications, education, profile } from '../data/site.js';
import SectionHead from './SectionHead.astro';
---

<section id="experience" class="section">
  <div class="container">
    <SectionHead title="Experience" />
    <div class="cols">
      <ol class="timeline">
        {
          experience.map((e, i) => (
            <li class={i === 0 ? 'current' : ''}>
              <strong>{e.org}</strong>
              <span class="role">{e.role}</span>
              <span class="period">{e.period}</span>
              <p class="text">{e.text}</p>
            </li>
          ))
        }
      </ol>

      <div class="side">
        <div class="box">
          <h3>Certifications</h3>
          <ul class="certs">
            {
              certifications.map((c) => (
                <li>
                  {c.name} <span>({c.issuer})</span>
                </li>
              ))
            }
          </ul>
          <a class="all" href={profile.certsUrl} rel="noopener">See all 59 on LinkedIn</a>
        </div>
        <div class="box">
          <h3>Education</h3>
          <p class="edu">
            {education.degree}
            <span>{education.school}, {education.period}</span>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cols {
    display: grid;
    gap: 32px;
  }
  @media (min-width: 900px) {
    .cols {
      grid-template-columns: 1fr 1.15fr;
      align-items: start;
    }
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 28px;
    position: relative;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 10px;
    bottom: 10px;
    width: 2px;
    background: var(--border);
  }
  .timeline li {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-bottom: 20px;
  }
  .timeline li::before {
    content: '';
    position: absolute;
    left: -28px;
    top: 6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ffffff;
    border: 2px solid #c9b8b0;
  }
  .timeline li.current::before {
    background: var(--coral);
    border-color: var(--coral);
    box-shadow: 0 0 0 5px #ffe3e6;
  }
  .timeline strong {
    font-family: var(--font-head);
    font-size: 1.1rem;
  }
  .role,
  .period {
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.45;
  }
  .text {
    margin: 6px 0 0;
    font-size: 0.92rem;
    color: #3a3533;
    line-height: 1.55;
  }
  .side {
    display: grid;
    gap: 16px;
  }
  .box {
    padding: 22px 24px;
    border-radius: var(--radius);
    background: var(--frame);
  }
  .certs {
    margin: 0 0 12px;
    padding-left: 18px;
    display: grid;
    gap: 6px;
    font-size: 0.9rem;
  }
  .certs span {
    color: var(--muted);
  }
  .all {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text);
  }
  .edu {
    margin: 0;
    font-size: 0.95rem;
    display: flex;
    flex-direction: column;
  }
  .edu span {
    color: var(--muted);
    font-size: 0.88rem;
  }
</style>
