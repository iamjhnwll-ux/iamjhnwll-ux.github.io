---
import { experience, certifications, education, profile } from '../data/site.js';
---

<section id="experience" class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Experience</span>
      <h2>Experience</h2>
    </div>
    <div class="cols">
      <ol class="timeline">
        {
          experience.map((e, i) => (
            <li class={i === 0 ? 'current' : ''}>
              <strong>{e.org}</strong>
              <span class="role">{e.role}</span>
              <span class="period">{e.period}</span>
            </li>
          ))
        }
      </ol>

      <div class="side">
        <div class="card box">
          <h3>Certifications</h3>
          <ul class="certs">
            {
              certifications.map((c) => (
                <li>
                  {c.name} <span>({c.issuer})</span>
                </li>
              ))
            }
          </ul>
          <a class="all" href={profile.certsUrl} rel="noopener">See all 59 on LinkedIn</a>
        </div>
        <div class="card box">
          <h3>Education</h3>
          <p class="edu">
            {education.degree}
            <span>{education.school}, {education.period}</span>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cols {
    display: grid;
    gap: 32px;
  }
  @media (min-width: 900px) {
    .cols {
      grid-template-columns: 1fr 1.15fr;
      align-items: start;
    }
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 26px;
    position: relative;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--border);
  }
  .timeline li {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-bottom: 18px;
  }
  .timeline li::before {
    content: '';
    position: absolute;
    left: -26px;
    top: 5px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--surface);
    border: 2px solid #9ca3af;
  }
  .timeline li.current::before {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  .timeline strong {
    font-size: 0.95rem;
  }
  .role,
  .period {
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.4;
  }
  .side {
    display: grid;
    gap: 14px;
  }
  .box {
    padding: 18px 20px;
  }
  .certs {
    margin: 0 0 10px;
    padding-left: 18px;
    display: grid;
    gap: 4px;
    font-size: 0.86rem;
  }
  .certs span {
    color: var(--muted);
  }
  .all {
    font-weight: 600;
    font-size: 0.88rem;
    text-decoration: none;
  }
  .edu {
    margin: 0;
    font-size: 0.9rem;
    display: flex;
    flex-direction: column;
  }
  .edu span {
    color: var(--muted);
    font-size: 0.84rem;
  }
</style>
