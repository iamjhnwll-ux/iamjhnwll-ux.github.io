---
const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#architecture', label: 'Architecture' },
  { href: '/#skills', label: 'Skills' },
  { href: '/#experience', label: 'Experience' },
];
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/">John Well Arellano</a>
    <nav aria-label="Main">
      <ul class="nav" id="nav-menu">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li class="nav-contact"><a href="/#contact">Contact</a></li>
      </ul>
    </nav>
    <a class="btn btn--primary cta" href="/#contact">Contact</a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav-menu" aria-label="Menu">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
  </div>
</header>

<script is:inline>
  (function () {
    const btn = document.querySelector('.menu-btn');
    const menu = document.getElementById('nav-menu');
    if (!btn || !menu) return;
    const set = function (open) {
      btn.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('open', open);
    };
    btn.addEventListener('click', function () {
      set(btn.getAttribute('aria-expanded') !== 'true');
    });
    menu.addEventListener('click', function (e) {
      if (e.target.closest('a')) set(false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        set(false);
        btn.focus();
      }
    });
    document.addEventListener('click', function (e) {
      if (!e.target.closest('.site-header')) set(false);
    });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(160%) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 60px;
  }
  .brand {
    color: var(--text);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.98rem;
    letter-spacing: -0.01em;
  }
  .nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: none;
  }
  .nav a {
    color: var(--text);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .nav a:hover {
    color: var(--accent);
  }
  .cta {
    display: none;
    padding: 8px 18px;
  }
  .menu-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    background: transparent;
    color: var(--text);
    cursor: pointer;
    border-radius: 8px;
  }
  .nav.open {
    display: grid;
    gap: 4px;
    position: absolute;
    top: 60px;
    left: 0;
    right: 0;
    padding: 12px var(--gutter) 18px;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow);
  }
  .nav.open a {
    display: block;
    padding: 10px 0;
    font-size: 1rem;
  }
  @media (min-width: 820px) {
    .nav,
    .nav.open {
      display: flex;
      gap: 32px;
      position: static;
      padding: 0;
      background: none;
      border: 0;
      box-shadow: none;
    }
    .nav.open a {
      padding: 0;
      font-size: 0.9rem;
    }
    .nav-contact,
    .menu-btn {
      display: none;
    }
    .cta {
      display: inline-flex;
    }
  }
</style>
