---
import { profile } from '../data/site.js';

// Set to '/profile.jpg' once a photo is added to public/.
const photo = null;
---

<section class="hero">
  <div class="glow" aria-hidden="true"></div>
  <div class="container inner">
    <span class="pill"><span class="dot" aria-hidden="true"></span>Open to part-time and contract work</span>
    <h1>
      John Well Arellano. Data Engineer building <em class="grad">governed data platforms</em> on Microsoft Fabric.
    </h1>
    <p class="lead">{profile.tagline}</p>
    <div class="ctas">
      <a class="btn btn--primary" href={`mailto:${profile.email}`}>Get in touch <span aria-hidden="true">&nearr;</span></a>
      <a class="btn btn--ghost" href="#work">See my work <span aria-hidden="true">&rsaquo;</span></a>
    </div>
    <p class="loc">{profile.location}</p>
    {
      photo && (
        <img class="photo" src={photo} alt={`Portrait of ${profile.name}`} width="140" height="140" />
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    margin-top: -72px;
    padding: 150px 0 64px;
    text-align: center;
  }
  .glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(620px 360px at 12% 18%, rgba(196, 181, 253, 0.45), transparent 70%),
      radial-gradient(760px 420px at 88% 8%, rgba(253, 186, 160, 0.55), transparent 70%),
      radial-gradient(700px 360px at 50% 0%, rgba(251, 207, 232, 0.6), transparent 72%);
    mask-image: linear-gradient(180deg, #000 55%, transparent 100%);
    pointer-events: none;
  }
  .inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid var(--border);
    font-size: 0.82rem;
    font-weight: 700;
    margin-bottom: 26px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
  }
  h1 {
    max-width: 920px;
    margin: 0 auto 22px;
    font-size: clamp(2.3rem, 5.4vw, 3.9rem);
  }
  .lead {
    max-width: 640px;
    font-size: 1.1rem;
    color: #3a3533;
    margin: 0 auto 30px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .loc {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0;
  }
  .photo {
    margin-top: 28px;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    object-fit: cover;
    filter: grayscale(1);
    border: 5px solid #ffffff;
    box-shadow: var(--shadow);
  }
</style>
