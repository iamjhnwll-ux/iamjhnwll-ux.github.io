---
import { profile } from '../data/site.js';

// Set to '/profile.jpg' once a photo is added to public/.
const photo = null;
---

<section class="hero">
  <div class="container inner">
    <div class="copy">
      <span class="pill"><span class="dot" aria-hidden="true"></span>Open to part-time and contract work</span>
      <h1>{profile.name}</h1>
      <p class="title">{profile.title}</p>
      <p class="tagline">{profile.tagline}</p>
      <div class="ctas">
        <a class="btn btn--primary" href="#work">See my work</a>
        <a class="btn btn--ghost" href={`mailto:${profile.email}`}>Email me</a>
      </div>
      <p class="loc">{profile.location}</p>
    </div>

    <div class="visual">
      <div class="glow" aria-hidden="true"></div>
      <div class="avatar">
        {
          photo ? (
            <img src={photo} alt={`Portrait of ${profile.name}`} width="180" height="180" />
          ) : (
            <span aria-hidden="true">JA</span>
          )
        }
      </div>
      <div class="card mini" role="img" aria-label="Medallion flow: Sources, Bronze, Silver, Gold, Power BI, promoted from DEV to QA to PROD">
        <div class="mini-flow" aria-hidden="true">
          <span class="layer layer--src">Sources</span><span class="arrow">&rarr;</span>
          <span class="layer layer--bronze">Bronze</span><span class="arrow">&rarr;</span>
          <span class="layer layer--silver">Silver</span><span class="arrow">&rarr;</span>
          <span class="layer layer--gold">Gold</span><span class="arrow">&rarr;</span>
          <span class="layer layer--bi">Power BI</span>
        </div>
        <div class="envs" aria-hidden="true">DEV &rarr; QA &rarr; PROD</div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 48px 0 24px;
  }
  .inner {
    display: grid;
    gap: 36px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .inner {
      grid-template-columns: 1.15fr 1fr;
      gap: 48px;
    }
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    font-size: 0.8rem;
    font-weight: 500;
    margin-bottom: 18px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
  }
  h1 {
    margin-bottom: 6px;
  }
  .title {
    font-size: clamp(1.25rem, 2.4vw, 1.6rem);
    font-weight: 700;
    color: var(--accent);
    letter-spacing: -0.015em;
    margin-bottom: 14px;
  }
  .tagline {
    font-size: 1.05rem;
    color: #374151;
    max-width: 560px;
    margin-bottom: 22px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 16px;
  }
  @media (max-width: 480px) {
    .ctas .btn {
      flex: 1;
    }
  }
  .loc {
    color: var(--muted);
    font-size: 0.88rem;
    margin: 0;
  }
  .visual {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }
  .glow {
    position: absolute;
    top: -10px;
    left: 50%;
    width: 340px;
    height: 260px;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, rgba(37, 99, 235, 0.14), transparent);
    pointer-events: none;
  }
  .avatar {
    position: relative;
    z-index: 1;
    width: 168px;
    height: 168px;
    border-radius: 50%;
    border: 6px solid var(--surface);
    box-shadow: 0 10px 30px rgba(17, 24, 39, 0.12);
    background: linear-gradient(135deg, #dbe8ff, #eef4ff);
    display: grid;
    place-items: center;
    overflow: hidden;
    margin-bottom: -18px;
  }
  .avatar span {
    font-size: 3rem;
    font-weight: 800;
    color: var(--accent);
    letter-spacing: -0.03em;
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
  }
  .mini {
    position: relative;
    width: 100%;
    max-width: 460px;
    padding: 34px 14px 14px;
  }
  .mini-flow {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 6px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }
  .envs {
    text-align: center;
    padding-top: 10px;
    font-size: 0.8rem;
    font-weight: 600;
  }
</style>
