---
import { services } from '../data/site.js';
import SectionHead from './SectionHead.astro';

const icons = {
  layers: '<path d="M12 3 2 8l10 5 10-5-10-5z"/><path d="m2 12.5 10 5 10-5"/><path d="m2 17 10 5 10-5"/>',
  pipeline: '<path d="m8 7-5 5 5 5"/><path d="m16 7 5 5-5 5"/><path d="m14 4-4 16"/>',
  model: '<ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5"/><path d="M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/>',
  chart: '<rect x="3" y="12" width="4" height="9" rx="1"/><rect x="10" y="7" width="4" height="14" rx="1"/><rect x="17" y="3" width="4" height="18" rx="1"/>',
};
const tints = ['#eef2ff', '#e3f6ec', '#ffe8ef', '#fff3cf'];
const inks = ['#4338ca', '#047857', '#be185d', '#a16207'];
---

<section id="services" class="section">
  <div class="container">
    <SectionHead
      title="Four roles, one engineer"
      intro="Data architect, data engineer, analytics engineer and BI developer: skills across the data lifecycle, applied inside a delivery team."
    />
    <div class="grid">
      {
        services.map((s, i) => (
          <article class="item" style={`--tint:${tints[i]};--ink:${inks[i]}`}>
            <span class="icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[s.icon]} />
            </span>
            <h3>{s.title}</h3>
            <ul>
              {s.points.map((p) => <li>{p}</li>)}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 18px;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1020px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .item {
    padding: 24px;
    border-radius: var(--radius);
    background: var(--frame);
  }
  .icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: var(--tint);
    color: var(--ink);
    margin-bottom: 16px;
  }
  ul {
    margin: 0;
    padding-left: 18px;
    display: grid;
    gap: 8px;
  }
  li {
    color: #3a3533;
    font-size: 0.92rem;
    line-height: 1.55;
  }
  li::marker {
    color: var(--ink);
  }
</style>
