---
import { services } from '../data/site.js';

const icons = {
  layers: '<path d="M12 3 2 8l10 5 10-5-10-5z"/><path d="m2 12.5 10 5 10-5"/><path d="m2 17 10 5 10-5"/>',
  pipeline: '<path d="m8 7-5 5 5 5"/><path d="m16 7 5 5-5 5"/><path d="m14 4-4 16"/>',
  model: '<ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5"/><path d="M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/>',
  chart: '<rect x="3" y="12" width="4" height="9" rx="1"/><rect x="10" y="7" width="4" height="14" rx="1"/><rect x="17" y="3" width="4" height="18" rx="1"/>',
};
---

<section id="services" class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">What I do</span>
      <h2>What I do</h2>
    </div>
    <div class="grid">
      {
        services.map((s) => (
          <article class="card item">
            <svg class="icon" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[s.icon]} />
            <h3>{s.title}</h3>
            <ul>
              {s.points.map((p) => <li>{p}</li>)}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 14px;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .item {
    padding: 20px;
  }
  .icon {
    color: var(--accent);
    margin-bottom: 14px;
  }
  ul {
    margin: 0;
    padding-left: 18px;
    display: grid;
    gap: 6px;
  }
  li {
    color: #374151;
    font-size: 0.86rem;
    line-height: 1.45;
  }
  li::marker {
    color: var(--text);
  }
</style>
