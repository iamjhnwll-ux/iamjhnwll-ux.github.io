---
import SectionHead from './SectionHead.astro';

const stages = [
  { key: 'src', name: 'Sources', sub: 'REST APIs, ERP, SharePoint, Excel' },
  { key: 'bronze', name: 'Bronze', sub: 'Lakehouse' },
  { key: 'silver', name: 'Silver', sub: 'Lakehouse' },
  { key: 'gold', name: 'Gold', sub: 'Warehouse' },
  { key: 'model', name: 'Semantic models', sub: 'Direct Lake, DAX, RLS' },
  { key: 'bi', name: 'Power BI', sub: 'apps' },
];

const governance = ['Git version control', 'CI/CD DEV to QA to PROD', 'Contract tests', 'RLS and RBAC', 'Monitoring'];
---

<section id="architecture" class="section">
  <div class="container">
    <SectionHead title="How I build" />
    <div class="diagram">
      <ol class="flow" aria-label="Data flow from sources to Power BI">
        {
          stages.map((s) => (
            <li class={`stage s-${s.key}`}>
              <strong>{s.name}</strong>
              <span>{s.sub}</span>
            </li>
          ))
        }
      </ol>
      <div class="gov">
        <span class="gov-label">Across every layer</span>
        <ul class="chips">
          {governance.map((g) => <li class="chip">{g}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .diagram {
    padding: 22px;
    border-radius: var(--radius);
    background: var(--frame);
  }
  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 22px;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 560px) {
    .flow {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1000px) {
    .flow {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 34px;
    }
  }
  .stage {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    min-height: 72px;
    padding: 12px;
    border-radius: 16px;
    background: var(--bg-c);
    color: var(--fg-c);
  }
  .s-src { --bg-c: var(--src-bg); --fg-c: var(--src-fg); }
  .s-bronze { --bg-c: var(--bronze-bg); --fg-c: var(--bronze-fg); }
  .s-silver { --bg-c: var(--silver-bg); --fg-c: var(--silver-fg); }
  .s-gold { --bg-c: var(--gold-bg); --fg-c: var(--gold-fg); }
  .s-model { --bg-c: var(--model-bg); --fg-c: var(--model-fg); }
  .s-bi { --bg-c: var(--bi-bg); --fg-c: var(--bi-fg); }
  .stage strong {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.25;
  }
  .stage span {
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .stage:not(:last-child)::after {
    content: '\2193' / '';
    position: absolute;
    bottom: -21px;
    left: 50%;
    transform: translateX(-50%);
    color: var(--text);
    font-weight: 700;
  }
  @media (min-width: 560px) {
    .stage:not(:last-child)::after {
      content: '\2192' / '';
      bottom: auto;
      top: 50%;
      left: auto;
      right: -11px;
      transform: translate(50%, -50%);
    }
    .stage:nth-child(3)::after {
      content: none;
    }
  }
  @media (min-width: 1000px) {
    .stage:not(:last-child)::after {
      right: -17px;
    }
    .stage:nth-child(3)::after {
      content: '\2192' / '';
    }
  }
  .gov {
    margin-top: 22px;
    padding: 14px 16px 18px;
    border: 1.5px dashed #d9c9c2;
    border-radius: 18px;
    text-align: center;
  }
  .gov-label {
    display: block;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--muted);
    margin-bottom: 10px;
  }
  .gov .chips {
    justify-content: center;
    gap: 10px;
  }
  .gov .chip {
    white-space: normal;
  }
</style>
