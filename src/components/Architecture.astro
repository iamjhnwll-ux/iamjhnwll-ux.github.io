---
const stages = [
  { key: 'src', name: 'Sources', sub: 'REST APIs, ERP, SharePoint, Excel' },
  { key: 'bronze', name: 'Bronze', sub: 'Lakehouse' },
  { key: 'silver', name: 'Silver', sub: 'Lakehouse' },
  { key: 'gold', name: 'Gold', sub: 'Warehouse' },
  { key: 'model', name: 'Semantic models', sub: 'Direct Lake, DAX, RLS' },
  { key: 'bi', name: 'Power BI', sub: 'apps' },
];

const governance = ['Git version control', 'CI/CD DEV to QA to PROD', 'Contract tests', 'RLS and RBAC', 'Monitoring'];
---

<section id="architecture" class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">How I build</span>
      <h2>How I build</h2>
    </div>

    <div class="card diagram">
      <ol class="flow" aria-label="Data flow from sources to Power BI">
        {
          stages.map((s) => (
            <li class={`stage layer--${s.key}`}>
              <strong>{s.name}</strong>
              <span>{s.sub}</span>
            </li>
          ))
        }
      </ol>
      <div class="gov">
        <span class="gov-label">Across every layer</span>
        <ul class="chips">
          {governance.map((g) => <li class="chip">{g}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .diagram {
    padding: 20px;
  }
  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 22px;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 560px) {
    .flow {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1000px) {
    .flow {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 34px;
    }
  }
  .stage {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    min-height: 64px;
    padding: 10px 12px;
    border-radius: 10px;
  }
  .stage.layer--src {
    background: var(--src-bg);
    color: var(--src-fg);
    border: 1px solid #d6e3ff;
  }
  .stage strong {
    font-size: 0.86rem;
    line-height: 1.25;
  }
  .stage span {
    font-size: 0.76rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .stage:not(:last-child)::after {
    content: '\2193' / '';
    position: absolute;
    bottom: -21px;
    left: 50%;
    transform: translateX(-50%);
    color: var(--text);
    font-weight: 600;
  }
  @media (min-width: 560px) {
    .stage:not(:last-child)::after {
      content: '\2192' / '';
      bottom: auto;
      top: 50%;
      left: auto;
      right: -11px;
      transform: translate(50%, -50%);
    }
    .stage:nth-child(3)::after {
      content: none;
    }
  }
  @media (min-width: 1000px) {
    .stage:not(:last-child)::after {
      right: -17px;
    }
    .stage:nth-child(3)::after {
      content: '\2192' / '';
    }
  }
  .gov {
    margin-top: 18px;
    padding: 12px 16px 16px;
    border: 1.5px dashed #cfd6e0;
    border-radius: 10px;
    text-align: center;
  }
  .gov-label {
    display: block;
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: 10px;
  }
  .gov .chips {
    justify-content: center;
    gap: 10px;
  }
  .gov .chip {
    background: var(--surface-2);
    white-space: normal;
  }
</style>
